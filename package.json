{
  "name": "reporacer",
  "version": "1.0.1",
  "description": "Benchmark AI coding agents on your own repository using real tasks mined from git history.",
  "type": "module",
  "bin": {
    "reporacer": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "RUNBOOK.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "DCO.md",
    "GOVERNANCE.md",
    "AUTHORS.md",
    "MAINTAINERS.md",
    "TRADEMARKS.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    ".env.example",
    "examples/config.json",
    "examples/buggy-todo-app/README.md",
    "examples/buggy-todo-app/scripts",
    "examples/nextjs-demo/README.md",
    "examples/nextjs-demo/package.json",
    "examples/nextjs-demo/app",
    "examples/nextjs-demo/test",
    "examples/python-demo/README.md",
    "examples/python-demo/pyproject.toml",
    "examples/python-demo/src/reporacer_demo.py",
    "examples/python-demo/tests/test_reporacer_demo.py",
    "examples/rust-demo/README.md",
    "examples/rust-demo/Cargo.toml",
    "examples/rust-demo/Cargo.lock",
    "examples/rust-demo/src",
    "scripts/build-demo-site.js",
    "scripts/check-external-release-readiness.js",
    "scripts/check-release-version.js",
    "scripts/check-static-links.js",
    "scripts/fix-vitepress-api-index.js",
    "scripts/generate-sbom.js",
    "scripts/generate-third-party-notices.js",
    "scripts/prepare.js",
    "scripts/smoke-packed-cli.js",
    "scripts/smoke-docker-sandbox.js",
    "docs/*.md",
    "docs/.vitepress/config.mts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run --coverage=false",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "docs:api": "typedoc --plugin typedoc-plugin-markdown --out docs/api/reference src/index.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "pnpm docs:api && node scripts/fix-vitepress-api-index.js && vitepress build docs && node scripts/fix-vitepress-api-index.js",
    "demo:build": "pnpm build && pnpm docs:build && node scripts/build-demo-site.js",
    "demo:check": "node scripts/check-static-links.js .reporacer-demo-site",
    "agents:verify": "node scripts/verify-agent-presets.js",
    "agents:verify:strict": "node scripts/verify-agent-presets.js --strict",
    "docker:sandbox:smoke": "node scripts/smoke-docker-sandbox.js",
    "package:smoke": "node scripts/smoke-packed-cli.js",
    "sbom": "node scripts/generate-sbom.js",
    "notices": "node scripts/generate-third-party-notices.js",
    "release:audit": "node scripts/release-audit.js",
    "release:external-audit": "node scripts/check-external-release-readiness.js",
    "commitlint": "commitlint --edit",
    "prepare": "node scripts/prepare.js",
    "prepack": "pnpm build"
  },
  "keywords": [
    "ai",
    "agents",
    "coding-agent",
    "benchmark",
    "git",
    "swe-bench",
    "codex",
    "claude",
    "gemini"
  ],
  "author": "HabrielStark and RepoRacer contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HabrielStark/RepoRacer.git"
  },
  "homepage": "https://github.com/HabrielStark/RepoRacer#readme",
  "bugs": {
    "url": "https://github.com/HabrielStark/RepoRacer/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/HabrielStark"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12",
      "vite": "8.0.13"
    }
  },
  "dependencies": {
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "execa": "10.0.1",
    "open": "11.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "10.4.0",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "tsx": "4.22.3",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vite": "8.0.13",
    "vitepress": "1.6.4",
    "vitest": "4.1.7"
  }
}
